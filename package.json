{
  "name": "mufunds",
  "version": "1.0.0",
  "private": true,
  "description": "Google Sheets add-on that adds a =muFunds() function for mutual fund, ETF, pension plan and stock data.",
  "homepage": "https://mufunds.com",
  "repository": "github:joseballester/muFunds",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/*.test.ts\"",
    "test:live": "node --test \"test/live/*.test.ts\"",
    "push": "npm run build && clasp push",
    "try": "node scripts/try.ts"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.13",
    "@types/node": "^24.19.2",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
